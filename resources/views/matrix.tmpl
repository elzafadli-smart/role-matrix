{{ define "matrix.tmpl" }}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartLink GroApp - RBAC Matrix Grid</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <!-- jQuery & Select2 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        [v-cloak] { display: none; }
        thead th {
            position: sticky;
            top: 0;
            z-index: 20;
            background-color: #0f172a;
            color: #f8fafc;
        }
        .action-chip {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .action-VIEW { background-color: #e0f2fe; color: #0369a1; }
        .action-CREATE { background-color: #dcfce7; color: #15803d; }
        .action-UPDATE { background-color: #fef3c7; color: #b45309; }
        .action-DELETE { background-color: #ffe4e6; color: #be123c; }
        .action-EXPORT { background-color: #f3e8ff; color: #7e22ce; }
        .action-PRINT { background-color: #f1f5f9; color: #475569; }
        .action-VOID { background-color: #fce7f3; color: #be185d; }
        .action-POST { background-color: #ccfbf1; color: #0f766e; }

        /* Modern Select2 Styling */
        .select2-container .select2-selection--single {
            height: 36px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.5rem !important;
            padding: 3px 8px !important;
            display: flex !important;
            align-items: center !important;
            background-color: #ffffff !important;
            box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05) !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #1e293b !important;
            font-size: 0.8125rem !important;
            line-height: 1.25rem !important;
            padding-left: 2px !important;
            padding-right: 20px !important;
            font-weight: 500 !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 34px !important;
            right: 6px !important;
        }
        .select2-container--default.select2-container--focus .select2-selection--single,
        .select2-container--default.select2-container--open .select2-selection--single {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
            outline: none !important;
        }
        .select2-dropdown {
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.75rem !important;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1) !important;
            overflow: hidden !important;
            font-size: 0.8125rem !important;
            z-index: 99999 !important;
            background-color: #ffffff !important;
        }
        .select2-search--dropdown {
            padding: 8px !important;
            background-color: #f8fafc !important;
            border-bottom: 1px solid #e2e8f0 !important;
        }
        .select2-search--dropdown .select2-search__field {
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.5rem !important;
            padding: 6px 10px !important;
            outline: none !important;
            font-size: 0.8125rem !important;
            width: 100% !important;
            background-color: #ffffff !important;
        }
        .select2-search--dropdown .select2-search__field:focus {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
        }
        .select2-results__option {
            padding: 8px 12px !important;
            font-size: 0.8125rem !important;
            color: #334155 !important;
        }
        .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
            background-color: #4f46e5 !important;
            color: #ffffff !important;
        }
        .select2-container--default .select2-results__option--selected {
            background-color: #e0e7ff !important;
            color: #3730a3 !important;
            font-weight: 600 !important;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col font-sans antialiased">
    <div id="app" v-cloak class="flex flex-col min-h-screen">
        <!-- Top Navigation Bar -->
        <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-40 border-b border-slate-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-white shadow">
                        <i class="fa-solid fa-table-cells text-base"></i>
                    </div>
                    <div>
                        <div class="font-extrabold text-base tracking-tight flex items-center space-x-2">
                            <span>SmartLink</span>
                            <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-400 font-semibold border border-indigo-500/30">RBAC Matrix Grid</span>
                        </div>
                        <div class="text-[11px] text-slate-400">Hierarki: <code class="text-indigo-300">Application &rarr; Module &rarr; Feature &rarr; Action &rarr; Role Matrix</code></div>
                    </div>
                </div>

                <nav class="flex bg-slate-800 p-1 rounded-lg text-xs font-medium space-x-1">
                    <a href="/" class="px-3 py-1.5 rounded-md transition text-slate-300 hover:text-white">
                        <i class="fa-solid fa-id-card-clip mr-1.5"></i> User Inspector
                    </a>
                    <a href="/matrix" class="px-3 py-1.5 rounded-md transition bg-indigo-600 text-white shadow">
                        <i class="fa-solid fa-table-cells mr-1.5"></i> Matrix Grid
                    </a>
                    <a href="/endpoints" class="px-3 py-1.5 rounded-md transition text-slate-300 hover:text-white">
                        <i class="fa-solid fa-route mr-1.5"></i> Endpoints
                    </a>
                    <a href="/ui-routes" class="px-3 py-1.5 rounded-md transition text-slate-300 hover:text-white">
                        <i class="fa-solid fa-compass mr-1.5"></i> UI Routes
                    </a>
                </nav>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="space-y-4">
                <!-- Search & Filter Bar -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center space-x-3 flex-1 min-w-[260px]">
                        <div class="relative w-full">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
                            <input v-model="searchKeyword" type="text" placeholder="Cari module, feature, action..." 
                                class="w-full pl-9 pr-4 py-1.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <!-- Application Dropdown -->
                        <div class="min-w-[190px]">
                            <select v-model="selectedApp" @change="onAppChange" v-select2 class="w-full">
                                <option value="">Semua Aplikasi</option>
                                <option v-for="app in applications" :key="app.code" :value="app.code">{[ app.name ]}</option>
                            </select>
                        </div>

                        <!-- Module Dropdown Picker -->
                        <div class="min-w-[220px] max-w-[280px]">
                            <select v-model="selectedModule" v-select2 class="w-full">
                                <option value="">Semua Module (Accordion)</option>
                                <option v-for="m in availableModules" :key="m.code" :value="m.code">
                                    {[ m.code ]} ({[ m.featureCount ]} fitur)
                                </option>
                            </select>
                        </div>

                        <!-- Role Filter Dropdown -->
                        <div class="min-w-[170px]">
                            <select v-model="filterRole" v-select2 class="w-full">
                                <option value="">Semua Role</option>
                                <option v-for="r in roles" :key="r" :value="r">{[ r ]}</option>
                            </select>
                        </div>

                        <!-- Accordion Action Buttons -->
                        <div class="flex items-center border border-slate-300 rounded-lg overflow-hidden bg-slate-50">
                            <button @click="expandAllModules" type="button" title="Buka Semua Module (Expand All)" class="px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:text-indigo-600 hover:bg-slate-100 transition border-r border-slate-300 flex items-center space-x-1">
                                <i class="fa-solid fa-angles-down text-[11px]"></i>
                                <span>Buka Semua</span>
                            </button>
                            <button @click="collapseAllModules" type="button" title="Tutup Semua Module (Collapse All)" class="px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:text-indigo-600 hover:bg-slate-100 transition flex items-center space-x-1">
                                <i class="fa-solid fa-angles-up text-[11px]"></i>
                                <span>Tutup Semua</span>
                            </button>
                        </div>

                        <!-- Simulate Query Action Button -->
                        <div class="flex items-center space-x-1.5">
                            <button @click="openSqlModal" type="button"
                                class="px-3 py-1.5 text-xs font-bold rounded-lg shadow-sm transition flex items-center space-x-2"
                                :class="changeCount > 0 ? 'bg-indigo-600 hover:bg-indigo-700 text-white ring-2 ring-indigo-300 shadow-indigo-200' : 'bg-slate-800 hover:bg-slate-900 text-slate-200'">
                                <i class="fa-solid fa-terminal text-amber-300 text-[11px]"></i>
                                <span>Simulate Query</span>
                                <span v-if="changeCount > 0" class="px-1.5 py-0.5 rounded-full bg-amber-400 text-slate-950 text-[10px] font-extrabold">
                                    {[ changeCount ]}
                                </span>
                            </button>
                            <button v-if="changeCount > 0" @click="resetAllChanges" type="button" title="Reset semua perubahan perizinan"
                                class="px-2 py-1.5 text-xs font-semibold rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition flex items-center space-x-1">
                                <i class="fa-solid fa-arrow-rotate-left text-[11px]"></i>
                                <span>Reset</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div v-if="loading" class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center text-slate-500">
                    <i class="fa-solid fa-circle-notch fa-spin text-2xl text-indigo-600 mb-2"></i>
                    <p class="text-xs">Memuat matriks perizinan RBAC...</p>
                </div>

                <!-- Matrix Table with Sticky Header & Accordion Modules -->
                <div v-else class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="overflow-auto max-h-[calc(100vh-210px)]">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead class="sticky top-0 z-20 bg-slate-900 shadow-md border-b-2 border-indigo-500">
                                <tr class="bg-slate-900 text-slate-200 text-xs uppercase tracking-wider font-bold">
                                    <th class="sticky top-0 z-20 bg-slate-900 py-3.5 px-4 w-1/4 text-white shadow-xs">Module &amp; Feature</th>
                                    <th class="sticky top-0 z-20 bg-slate-900 py-3.5 px-3 w-36 text-white shadow-xs">Action &amp; Detail</th>
                                    <th v-for="role in roles" :key="role" class="sticky top-0 z-20 bg-slate-900 py-3.5 px-3 text-center shadow-xs transition"
                                        :class="filterRole === role ? 'bg-indigo-950 text-amber-300 border-x-2 border-indigo-500 font-extrabold shadow-inner' : 'text-slate-200'">
                                        {[ role ]}
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <template v-for="app in filteredApplications" :key="app.code">
                                    <!-- App Group Header -->
                                    <tr class="bg-slate-800 text-white font-semibold border-y border-slate-700">
                                        <td :colspan="2 + roles.length" class="py-2.5 px-4 text-xs tracking-wide">
                                            <i class="fa-solid fa-layer-group mr-2 text-indigo-400"></i> {[ app.name ]}
                                        </td>
                                    </tr>

                                    <!-- Module Accordion Header Rows -->
                                    <template v-for="mod in app.modules" :key="mod.code">
                                        <tr @click="toggleModule(app.code, mod.code)" 
                                            class="cursor-pointer select-none transition border-t border-slate-200"
                                            :class="isModuleOpen(app.code, mod.code) ? 'bg-indigo-50/70 hover:bg-indigo-100/70 text-indigo-950' : 'bg-slate-50 hover:bg-slate-100/80 text-slate-700'">
                                            <td :colspan="2 + roles.length" class="py-2.5 px-4 text-xs">
                                                <div class="flex items-center justify-between">
                                                    <div class="flex items-center space-x-2.5">
                                                        <span class="w-4 text-center text-indigo-600 transition-transform">
                                                            <i class="fa-solid" 
                                                               :class="isModuleOpen(app.code, mod.code) ? 'fa-chevron-down' : 'fa-chevron-right'"></i>
                                                        </span>
                                                        <i class="fa-solid text-slate-400"
                                                           :class="isModuleOpen(app.code, mod.code) ? 'fa-folder-open text-indigo-600' : 'fa-folder'"></i>
                                                        <span class="font-medium">Module: <strong class="font-bold text-slate-900">{[ mod.code ]}</strong></span>
                                                    </div>
                                                    <div class="flex items-center space-x-2 text-[11px]">
                                                        <span class="px-2 py-0.5 rounded-full font-semibold border"
                                                              :class="isModuleOpen(app.code, mod.code) ? 'bg-indigo-100 border-indigo-200 text-indigo-900' : 'bg-slate-200/70 border-slate-300 text-slate-600'">
                                                            {[ mod.features.length ]} Fitur &bull; {[ getModuleActionCount(mod) ]} Aksi
                                                        </span>
                                                        <span class="text-[11px] text-slate-400 font-normal">
                                                            {[ isModuleOpen(app.code, mod.code) ? '(klik untuk ciutkan)' : '(klik untuk buka)' ]}
                                                        </span>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- Collapsible Feature & Action Rows -->
                                        <template v-if="isModuleOpen(app.code, mod.code)">
                                            <template v-for="feat in mod.features" :key="feat.code">
                                                <template v-for="(act, idx) in feat.actions" :key="getActionKey(feat.code, act)">
                                                    <tr class="hover:bg-slate-50/80 transition" :class="isActionOpen(getActionKey(feat.code, act)) ? 'bg-indigo-50/30' : ''">
                                                        <td class="py-2 px-4 text-xs text-slate-700 font-mono">
                                                            <span v-if="idx === 0" class="flex items-center space-x-1.5 pl-6">
                                                                <i class="fa-regular fa-file-code text-slate-400"></i>
                                                                <span class="font-bold text-slate-900">{[ feat.code ]}</span>
                                                            </span>
                                                        </td>
                                                        <td class="py-2 px-3">
                                                            <button @click.stop="toggleActionDetails(getActionKey(feat.code, act))" 
                                                                type="button" 
                                                                class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded-lg hover:bg-slate-200/70 border border-transparent hover:border-slate-300 transition group text-left cursor-pointer select-none"
                                                                :title="isActionOpen(getActionKey(feat.code, act)) ? 'Tutup rincian baris' : 'Buka rincian baris endpoint & ui route'">
                                                                <span class="action-chip" :class="'action-' + act.action">{[ act.action ]}</span>
                                                                <span v-if="(act.endpoints && act.endpoints.length) || (act.ui_routes && act.ui_routes.length)" class="text-[10px] font-mono font-medium text-slate-400 group-hover:text-indigo-600">
                                                                    ({[ (act.endpoints || []).length + (act.ui_routes || []).length ]})
                                                                </span>
                                                                <i class="fa-solid text-[9px] text-slate-400 group-hover:text-indigo-600 transition-transform duration-200"
                                                                   :class="isActionOpen(getActionKey(feat.code, act)) ? 'fa-chevron-up text-indigo-600' : 'fa-chevron-down'"></i>
                                                            </button>
                                                        </td>
                                                        <td v-for="role in roles" :key="role" class="py-2 px-3 text-center select-none cursor-pointer transition hover:bg-indigo-100/50"
                                                            :class="[
                                                                filterRole === role ? 'bg-indigo-50/50 border-x border-indigo-100' : '',
                                                                isPermissionModified(app.code, mod.code, feat.code, act, role) ? (hasRolePermission(app.code, mod.code, feat.code, act, role) ? 'bg-emerald-50/70' : 'bg-rose-50/70') : ''
                                                            ]"
                                                            @click.stop="togglePermission(app.code, mod.code, feat.code, act, role)"
                                                            :title="getCellTooltip(app.code, mod.code, feat.code, act, role)">
                                                            <!-- Case 1: Newly Granted (Modified INSERT) -->
                                                            <span v-if="isPermissionNewlyGranted(app.code, mod.code, feat.code, act, role)" 
                                                                class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-600 text-white text-xs shadow-sm ring-2 ring-emerald-300 animate-pulse"
                                                                title="Baru dicentang (akan di-INSERT). Klik untuk batalkan.">
                                                                <i class="fa-solid fa-check"></i>
                                                            </span>
                                                            <!-- Case 2: Newly Revoked (Modified DELETE) -->
                                                            <span v-else-if="isPermissionNewlyRevoked(app.code, mod.code, feat.code, act, role)" 
                                                                class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-rose-100 text-rose-600 text-xs shadow-sm ring-2 ring-rose-300"
                                                                title="Baru dicabut (akan di-DELETE). Klik untuk batalkan.">
                                                                <i class="fa-solid fa-xmark"></i>
                                                            </span>
                                                            <!-- Case 3: Originally Granted (Unchanged) -->
                                                            <span v-else-if="hasRolePermission(app.code, mod.code, feat.code, act, role)" 
                                                                class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 text-xs hover:bg-rose-100 hover:text-rose-600 transition group/cell"
                                                                title="Izin aktif. Klik untuk mencabut.">
                                                                <i class="fa-solid fa-check group-hover/cell:hidden"></i>
                                                                <i class="fa-solid fa-xmark hidden group-hover/cell:inline"></i>
                                                            </span>
                                                            <!-- Case 4: Originally Unchecked (Unchanged) -->
                                                            <span v-else 
                                                                class="inline-flex items-center justify-center w-5 h-5 rounded-full text-slate-300 hover:bg-emerald-100 hover:text-emerald-700 transition group/cell"
                                                                title="Belum ada izin. Klik untuk mencentang.">
                                                                <span class="inline-block w-2 h-0.5 bg-slate-200 rounded group-hover/cell:hidden"></span>
                                                                <i class="fa-solid fa-plus hidden group-hover/cell:inline text-[10px]"></i>
                                                            </span>
                                                        </td>
                                                    </tr>

                                                    <!-- Sub-rows when action is expanded: API Endpoints & UI Routes pushed to align with Action column -->
                                                    <template v-if="isActionOpen(getActionKey(feat.code, act))">
                                                        <!-- SECTION 1: API ENDPOINTS -->
                                                        <!-- Header: API Endpoints -->
                                                        <tr class="bg-indigo-50/80 border-t-2 border-indigo-200">
                                                            <td class="bg-slate-50/40 border-r border-indigo-100"></td>
                                                            <td :colspan="1 + roles.length" class="py-2 px-3 text-xs border-l-4 border-indigo-500">
                                                                <div class="flex items-center justify-between pl-2">
                                                                    <div class="flex items-center space-x-2 font-bold text-indigo-950">
                                                                        <i class="fa-solid fa-network-wired text-indigo-600"></i>
                                                                        <span>API Endpoints Terkait</span>
                                                                        <span class="px-2 py-0.5 rounded-full text-[10px] bg-indigo-200/80 text-indigo-900 font-mono font-bold">
                                                                            {[ (act.endpoints || []).length ]}
                                                                        </span>
                                                                    </div>
                                                                    <div class="text-[11px] text-slate-500 font-mono pr-4">
                                                                        Permission: <code class="text-indigo-700 bg-white px-1.5 py-0.5 rounded border border-indigo-100 font-semibold">{[ act.permission_key ]}</code>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        <!-- API Endpoint Rows (Aligned with Action Column) -->
                                                        <template v-if="act.endpoints && act.endpoints.length > 0">
                                                            <tr v-for="ep in act.endpoints" :key="'ep:' + ep" class="bg-slate-50/60 hover:bg-indigo-50/40 transition border-t border-slate-100">
                                                                <td class="bg-slate-50/40 border-r border-indigo-100"></td>
                                                                <td :colspan="1 + roles.length" class="py-2 px-3 text-xs font-mono border-l-4 border-indigo-500">
                                                                    <div class="flex items-center justify-between gap-3 pl-2 pr-2">
                                                                        <div class="flex items-center space-x-3 min-w-0">
                                                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono tracking-wider shadow-2xs shrink-0"
                                                                                :class="getMethodClass(getEndpointMethod(ep))">
                                                                                {[ getEndpointMethod(ep) ]}
                                                                            </span>
                                                                            <span class="font-bold text-slate-800 text-xs break-all">{[ getEndpointPath(ep) ]}</span>
                                                                        </div>
                                                                        <span v-if="getEndpointService(ep)" class="inline-flex items-center space-x-1.5 px-2 py-0.5 rounded-md text-[11px] bg-slate-100 text-slate-700 border border-slate-200 shrink-0 font-sans shadow-2xs ml-auto">
                                                                            <i class="fa-solid fa-server text-[10px] text-indigo-500"></i>
                                                                            <span class="text-slate-400 font-semibold text-[10px] uppercase tracking-wider">service:</span>
                                                                            <span class="font-mono font-bold text-slate-800">{[ getEndpointService(ep) ]}</span>
                                                                        </span>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </template>
                                                        <tr v-else class="bg-slate-50/30 border-t border-slate-100">
                                                            <td class="bg-slate-50/40 border-r border-indigo-100"></td>
                                                            <td :colspan="1 + roles.length" class="py-2 px-3 pl-4 text-slate-400 italic text-xs border-l-4 border-indigo-500">
                                                                <i class="fa-regular fa-circle-question mr-1.5"></i> Tidak ada API endpoint yang dipetakan ke aksi ini.
                                                            </td>
                                                        </tr>

                                                        <!-- SECTION 2: FRONTEND UI ROUTES -->
                                                        <!-- Header: Frontend UI Routes -->
                                                        <tr class="bg-purple-50/80 border-t-2 border-purple-200">
                                                            <td class="bg-slate-50/40 border-r border-purple-100"></td>
                                                            <td :colspan="1 + roles.length" class="py-2 px-3 text-xs border-l-4 border-purple-500">
                                                                <div class="flex items-center space-x-2 font-bold text-purple-950 pl-2">
                                                                    <i class="fa-solid fa-compass text-purple-600"></i>
                                                                    <span>Frontend UI Routes Terkait</span>
                                                                    <span class="px-2 py-0.5 rounded-full text-[10px] bg-purple-200/80 text-purple-900 font-mono font-bold">
                                                                        {[ (act.ui_routes || []).length ]}
                                                                    </span>
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        <!-- UI Route Rows (Aligned with Action Column) -->
                                                        <template v-if="act.ui_routes && act.ui_routes.length > 0">
                                                            <tr v-for="ur in act.ui_routes" :key="'ur:' + ur" class="bg-slate-50/60 hover:bg-purple-50/40 transition border-t border-slate-100">
                                                                <td class="bg-slate-50/40 border-r border-purple-100"></td>
                                                                <td :colspan="1 + roles.length" class="py-2 px-3 text-xs font-mono border-l-4 border-purple-500">
                                                                    <div class="flex items-center space-x-3 pl-2">
                                                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-purple-100 text-purple-800 border border-purple-200 tracking-wider shrink-0">
                                                                            ROUTE
                                                                        </span>
                                                                        <i class="fa-regular fa-window-maximize text-purple-500 text-xs shrink-0"></i>
                                                                        <span class="text-purple-950 font-bold text-xs break-all">{[ ur ]}</span>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </template>
                                                        <tr v-else class="bg-slate-50/30 border-t border-slate-100">
                                                            <td class="bg-slate-50/40 border-r border-purple-100"></td>
                                                            <td :colspan="1 + roles.length" class="py-2 px-3 pl-4 text-slate-400 italic text-xs border-l-4 border-purple-500">
                                                                <i class="fa-regular fa-circle-question mr-1.5"></i> Tidak ada UI route yang dipetakan ke aksi ini.
                                                            </td>
                                                        </tr>
                                                    </template>
                                                </template>
                                            </template>
                                        </template>
                                    </template>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <!-- Floating Changes Bar (When changeCount > 0) -->
        <div v-if="changeCount > 0" class="fixed bottom-6 right-6 z-40 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl border border-slate-700 flex items-center space-x-4 animate-bounce-subtle">
            <div class="flex items-center space-x-2 text-xs">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping"></span>
                <span class="font-bold text-amber-300">{[ changeCount ]} Perubahan Terdeteksi</span>
                <span class="text-slate-400">(+{[ newlyCheckedCount ]} / -{[ newlyUncheckedCount ]})</span>
            </div>
            <div class="flex items-center space-x-2">
                <button @click="openSqlModal" type="button" class="px-3.5 py-1.5 text-xs font-bold rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white shadow-md transition flex items-center space-x-1.5 cursor-pointer">
                    <i class="fa-solid fa-terminal text-[11px] text-amber-300"></i>
                    <span>Simulate Query SQL</span>
                </button>
                <button @click="resetAllChanges" type="button" title="Batalkan semua perubahan" class="px-2.5 py-1.5 text-xs font-semibold rounded-xl bg-slate-800 hover:bg-rose-900 text-slate-300 hover:text-white border border-slate-700 transition cursor-pointer">
                    <i class="fa-solid fa-arrow-rotate-left text-[11px]"></i>
                </button>
            </div>
        </div>

        <!-- SQL Simulation Modal Dialog -->
        <div v-if="showSqlModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-xs select-none" @click.self="closeSqlModal" @keydown.window.escape="closeSqlModal">
            <div class="bg-slate-900 text-slate-100 rounded-2xl shadow-2xl border border-slate-700 w-full max-w-4xl max-h-[92vh] flex flex-col overflow-hidden select-text">
                <!-- Modal Header -->
                <div class="px-6 py-4 bg-slate-850 border-b border-slate-800 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-md">
                            <i class="fa-solid fa-terminal text-lg text-amber-300"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-2.5">
                                <h3 class="text-base font-extrabold text-white tracking-tight">Simulasi Query SQL RBAC</h3>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-950 text-indigo-300 border border-indigo-700/50">
                                    be-groapp-ddl format
                                </span>
                            </div>
                            <p class="text-xs text-slate-400 mt-0.5">
                                Preview SQL idempotent seeder khusus untuk perubahan (diff) yang telah dicentang.
                            </p>
                        </div>
                    </div>
                    <button @click="closeSqlModal" type="button" class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800 transition cursor-pointer">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <!-- Modal Subheader & Filter Tabs -->
                <div class="px-6 py-3 bg-slate-950/60 border-b border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs">
                    <div class="flex items-center space-x-2 font-mono">
                        <span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 font-bold border border-slate-700">
                            Total: {[ changeCount ]}
                        </span>
                        <span class="px-2 py-0.5 rounded-md bg-emerald-950 text-emerald-400 font-bold border border-emerald-800/50">
                            +{[ newlyCheckedCount ]} Ditambahkan (INSERT)
                        </span>
                        <span class="px-2 py-0.5 rounded-md bg-rose-950 text-rose-400 font-bold border border-rose-800/50">
                            -{[ newlyUncheckedCount ]} Dicabut (DELETE)
                        </span>
                    </div>

                    <!-- Filter Mode Tabs -->
                    <div class="flex items-center bg-slate-800 p-1 rounded-lg border border-slate-700">
                        <button @click="sqlFilterMode = 'all'" type="button"
                            class="px-2.5 py-1 rounded-md font-semibold transition cursor-pointer"
                            :class="sqlFilterMode === 'all' ? 'bg-indigo-600 text-white shadow-xs' : 'text-slate-400 hover:text-slate-200'">
                            Semua Perubahan ({[ changeCount ]})
                        </button>
                        <button @click="sqlFilterMode = 'insert_only'" type="button"
                            class="px-2.5 py-1 rounded-md font-semibold transition cursor-pointer"
                            :class="sqlFilterMode === 'insert_only' ? 'bg-emerald-600 text-white shadow-xs' : 'text-slate-400 hover:text-slate-200'">
                            Hanya INSERT ({[ newlyCheckedCount ]})
                        </button>
                        <button @click="sqlFilterMode = 'delete_only'" type="button"
                            class="px-2.5 py-1 rounded-md font-semibold transition cursor-pointer"
                            :class="sqlFilterMode === 'delete_only' ? 'bg-rose-600 text-white shadow-xs' : 'text-slate-400 hover:text-slate-200'">
                            Hanya DELETE ({[ newlyUncheckedCount ]})
                        </button>
                    </div>
                </div>

                <!-- Modal Code Body -->
                <div class="flex-1 p-6 overflow-auto max-h-[56vh] bg-slate-950">
                    <div v-if="changeCount === 0" class="py-12 text-center text-slate-500">
                        <i class="fa-regular fa-folder-open text-4xl mb-3 text-slate-600"></i>
                        <p class="text-sm font-semibold text-slate-300">Belum Ada Perubahan Perizinan</p>
                        <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
                            Silakan klik sel pada tabel matriks perizinan untuk mencentang (grant) atau mencabut (revoke) izin peran. Query SQL akan otomatis digenerate secara langsung.
                        </p>
                    </div>
                    <div v-else class="relative group">
                        <pre class="font-mono text-xs leading-relaxed text-slate-200 overflow-x-auto whitespace-pre p-4 rounded-xl bg-slate-900 border border-slate-800 select-all"><code>{[ generatedSql ]}</code></pre>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="px-6 py-3.5 bg-slate-850 border-t border-slate-800 flex items-center justify-between">
                    <div class="text-xs text-slate-400 flex items-center space-x-1.5">
                        <i class="fa-solid fa-circle-info text-indigo-400 text-[11px]"></i>
                        <span>Query di atas hanya untuk perizinan yang <strong>diubah/tercentang baru</strong> (diff), siap dieksekusi di database.</span>
                    </div>
                    <div class="flex items-center space-x-2.5">
                        <button @click="copySqlToClipboard" type="button" :disabled="changeCount === 0"
                            class="px-4 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-2 shadow-sm cursor-pointer"
                            :class="copiedSql ? 'bg-emerald-600 text-white ring-2 ring-emerald-400' : (changeCount === 0 ? 'bg-slate-800 text-slate-500 cursor-not-allowed' : 'bg-indigo-600 hover:bg-indigo-500 text-white')">
                            <i class="fa-solid" :class="copiedSql ? 'fa-check' : 'fa-copy'"></i>
                            <span>{[ copiedSql ? 'Tersalin ke Clipboard!' : 'Salin Query SQL' ]}</span>
                        </button>
                        <button @click="closeSqlModal" type="button"
                            class="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 transition cursor-pointer">
                            Tutup
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500">
            Powered by <strong>Goravel</strong> framework &bull; SmartLink GroApp RBAC Role Viewer
        </footer>
    </div>

    <script>
        const { createApp } = Vue;

        const select2Directive = {
            mounted(el, binding) {
                const $el = $(el);
                $el.select2({
                    width: '100%',
                    dropdownAutoWidth: true,
                    minimumResultsForSearch: (binding.modifiers && binding.modifiers.nosearch) ? -1 : 0
                });

                el._prevOptionCount = el.options.length;

                $el.on('select2:select select2:unselect select2:clear', function() {
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                });
            },
            updated(el, binding) {
                const $el = $(el);
                const currentOptionCount = el.options.length;
                if (el._prevOptionCount !== currentOptionCount) {
                    el._prevOptionCount = currentOptionCount;
                    $el.select2({
                        width: '100%',
                        dropdownAutoWidth: true,
                        minimumResultsForSearch: (binding.modifiers && binding.modifiers.nosearch) ? -1 : 0
                    });
                }
                if ($el.val() !== el.value) {
                    $el.val(el.value).trigger('change.select2');
                }
            },
            unmounted(el) {
                $(el).select2('destroy');
            }
        };

        createApp({
            delimiters: ['{[', ']}'],
            directives: {
                select2: select2Directive
            },
            data() {
                return {
                    loading: true,
                    roles: [],
                    applications: [],
                    searchKeyword: '',
                    selectedApp: '',
                    selectedModule: '',
                    expandedModules: {},
                    expandedActionDetails: {},
                    filterRole: '',
                    initialPermissions: {},
                    permissionOverrides: {},
                    showSqlModal: false,
                    sqlFilterMode: 'all',
                    copiedSql: false,
                };
            },
            computed: {
                availableModules() {
                    const list = [];
                    const seen = new Set();
                    let apps = this.applications;
                    if (this.selectedApp) {
                        apps = apps.filter(a => a.code === this.selectedApp);
                    }
                    for (const app of apps) {
                        for (const mod of (app.modules || [])) {
                            if (!seen.has(mod.code)) {
                                seen.add(mod.code);
                                list.push({
                                    code: mod.code,
                                    appCode: app.code,
                                    featureCount: (mod.features || []).length
                                });
                            }
                        }
                    }
                    return list;
                },
                filteredApplications() {
                    let apps = this.applications;
                    if (this.selectedApp) {
                        apps = apps.filter(a => a.code === this.selectedApp);
                    }
                    if (this.selectedModule) {
                        apps = apps.map(app => {
                            const matched = (app.modules || []).filter(m => m.code === this.selectedModule);
                            return { ...app, modules: matched };
                        }).filter(app => app.modules.length > 0);
                    }
                    if (!this.searchKeyword) return apps;

                    const kw = this.searchKeyword.toLowerCase();
                    return apps.map(app => {
                        const filteredModules = (app.modules || []).map(mod => {
                            const filteredFeatures = (mod.features || []).map(feat => {
                                const matchedActions = (feat.actions || []).filter(act => {
                                    return act.action.toLowerCase().includes(kw) ||
                                           feat.code.toLowerCase().includes(kw) ||
                                           mod.code.toLowerCase().includes(kw);
                                });
                                return { ...feat, actions: matchedActions };
                            }).filter(feat => feat.actions.length > 0);
                            return { ...mod, features: filteredFeatures };
                        }).filter(mod => mod.features.length > 0);
                        return { ...app, modules: filteredModules };
                    }).filter(app => app.modules.length > 0);
                },
                changes() {
                    return Object.values(this.permissionOverrides);
                },
                changeCount() {
                    return this.changes.length;
                },
                newlyCheckedCount() {
                    return this.changes.filter(c => c.granted && !c.initial).length;
                },
                newlyUncheckedCount() {
                    return this.changes.filter(c => !c.granted && c.initial).length;
                },
                generatedSql() {
                    if (this.changes.length === 0) {
                        return '-- Tidak ada perubahan perizinan yang dipilih.\n-- Centang atau batalkan centang pada tabel matriks untuk membuat query simulasi.';
                    }

                    const escapeSql = (s) => (s || '').replace(/'/g, "''");
                    const grants = this.changes.filter(c => c.granted && !c.initial);
                    const revokes = this.changes.filter(c => !c.granted && c.initial);

                    let output = [];
                    const now = new Date();
                    const timestamp = now.getFullYear() + '-' +
                        String(now.getMonth() + 1).padStart(2, '0') + '-' +
                        String(now.getDate()).padStart(2, '0') + ' ' +
                        String(now.getHours()).padStart(2, '0') + ':' +
                        String(now.getMinutes()).padStart(2, '0') + ':' +
                        String(now.getSeconds()).padStart(2, '0');

                    output.push('-- ============================================================');
                    output.push('-- RBAC SEEDER: ROLE_PERMISSIONS (SIMULATION DIFF)');
                    output.push('-- Generated: ' + timestamp);
                    output.push('-- Total Changes: ' + this.changes.length + ' (' + grants.length + ' Ditambahkan/INSERT, ' + revokes.length + ' Dicabut/DELETE)');
                    output.push('-- Format: be-groapp-ddl/seeder/rbac/*.sql (Idempotent)');
                    output.push('-- ============================================================');
                    output.push('');

                    // 1. INSERTS (GRANTS)
                    if ((this.sqlFilterMode === 'all' || this.sqlFilterMode === 'insert_only') && grants.length > 0) {
                        output.push('-- ============================================================');
                        output.push('-- 1. GRANT ROLE PERMISSIONS (INSERT - ' + grants.length + ' item)');
                        output.push('-- ============================================================');

                        for (const g of grants) {
                            output.push(`-- Grant: ${g.roleName} -> ${g.appCode} / ${g.modCode} / ${g.featCode} / ${g.actionCode}`);
                            output.push('INSERT INTO role_permissions (role_id, feature_action_id)');
                            output.push('SELECT r.id, fa.id');
                            output.push('FROM roles r');
                            output.push('JOIN feature_actions fa ON true');
                            output.push('JOIN features f ON f.id = fa.feature_id');
                            output.push(`JOIN modules m ON m.id = f.module_id AND m.code = '${escapeSql(g.modCode)}'`);
                            output.push(`JOIN applications app ON app.id = m.application_id AND app.code = '${escapeSql(g.appCode)}'`);
                            output.push(`JOIN actions a ON a.id = fa.action_id AND a.code = '${escapeSql(g.actionCode)}'`);
                            output.push(`WHERE r.name = '${escapeSql(g.roleName)}'`);
                            output.push(`  AND f.code = '${escapeSql(g.featCode)}'`);
                            output.push('ON CONFLICT (role_id, feature_action_id) DO NOTHING;');
                            output.push('');
                        }
                    }

                    // 2. DELETES (REVOKES)
                    if ((this.sqlFilterMode === 'all' || this.sqlFilterMode === 'delete_only') && revokes.length > 0) {
                        output.push('-- ============================================================');
                        output.push('-- 2. REVOKE ROLE PERMISSIONS (DELETE - ' + revokes.length + ' item)');
                        output.push('-- ============================================================');

                        for (const r of revokes) {
                            output.push(`-- Revoke: ${r.roleName} -> ${r.appCode} / ${r.modCode} / ${r.featCode} / ${r.actionCode}`);
                            output.push('DELETE FROM role_permissions');
                            output.push(`WHERE role_id = (SELECT id FROM roles WHERE name = '${escapeSql(r.roleName)}')`);
                            output.push('  AND feature_action_id IN (');
                            output.push('    SELECT fa.id');
                            output.push('    FROM feature_actions fa');
                            output.push('    JOIN features f ON f.id = fa.feature_id');
                            output.push('    JOIN modules m ON m.id = f.module_id');
                            output.push('    JOIN applications app ON app.id = m.application_id');
                            output.push('    JOIN actions a ON a.id = fa.action_id');
                            output.push(`    WHERE app.code = '${escapeSql(r.appCode)}'`);
                            output.push(`      AND m.code = '${escapeSql(r.modCode)}'`);
                            output.push(`      AND f.code = '${escapeSql(r.featCode)}'`);
                            output.push(`      AND a.code = '${escapeSql(r.actionCode)}'`);
                            output.push('  );');
                            output.push('');
                        }
                    }

                    return output.join('\n');
                }
            },
            methods: {
                getActionKey(featCode, act) {
                    return act.feature_action_id || (featCode + ':' + act.action);
                },
                toggleActionDetails(key) {
                    this.expandedActionDetails[key] = !this.expandedActionDetails[key];
                    this.expandedActionDetails = { ...this.expandedActionDetails };
                },
                isActionOpen(key) {
                    return !!this.expandedActionDetails[key];
                },
                getEndpointMethod(ep) {
                    if (!ep) return 'API';
                    const parts = ep.trim().split(/\s+/);
                    return parts[0] || 'API';
                },
                getEndpointPath(ep) {
                    if (!ep) return '';
                    const parts = ep.trim().split(/\s+/);
                    if (parts.length > 1) {
                        const rest = parts.slice(1).join(' ');
                        const parenIdx = rest.indexOf('(');
                        if (parenIdx !== -1) {
                            return rest.substring(0, parenIdx).trim();
                        }
                        return rest;
                    }
                    return ep;
                },
                getEndpointService(ep) {
                    if (!ep) return '';
                    const m = ep.match(/\(([^)]+)\)/);
                    return m ? m[1] : '';
                },
                getMethodClass(method) {
                    const m = (method || '').toUpperCase();
                    if (m === 'GET') return 'bg-blue-100 text-blue-800 border border-blue-200';
                    if (m === 'POST') return 'bg-emerald-100 text-emerald-800 border border-emerald-200';
                    if (m === 'PUT' || m === 'PATCH') return 'bg-amber-100 text-amber-800 border border-amber-200';
                    if (m === 'DELETE') return 'bg-rose-100 text-rose-800 border border-rose-200';
                    return 'bg-slate-100 text-slate-700 border border-slate-200';
                },
                isModuleOpen(appCode, modCode) {
                    if (this.searchKeyword || this.selectedModule) return true;
                    const key = appCode + ':' + modCode;
                    return !!this.expandedModules[key];
                },
                toggleModule(appCode, modCode) {
                    const key = appCode + ':' + modCode;
                    this.expandedModules[key] = !this.expandedModules[key];
                    this.expandedModules = { ...this.expandedModules };
                },
                expandAllModules() {
                    const next = {};
                    for (const app of this.applications) {
                        for (const mod of (app.modules || [])) {
                            next[app.code + ':' + mod.code] = true;
                        }
                    }
                    this.expandedModules = next;
                },
                onAppChange() {
                    this.selectedModule = '';
                },
                collapseAllModules() {
                    this.expandedModules = {};
                    this.expandedActionDetails = {};
                },
                getModuleActionCount(mod) {
                    if (!mod || !mod.features) return 0;
                    return mod.features.reduce((acc, feat) => acc + (feat.actions ? feat.actions.length : 0), 0);
                },
                getCellKey(appCode, modCode, featCode, act, role) {
                    return appCode + '|' + modCode + '|' + featCode + '|' + act.action + '|' + role;
                },
                hasRolePermission(appCode, modCode, featCode, act, role) {
                    const key = this.getCellKey(appCode, modCode, featCode, act, role);
                    if (this.permissionOverrides[key] !== undefined) {
                        return this.permissionOverrides[key].granted;
                    }
                    return !!(act.roles && act.roles[role]);
                },
                isPermissionModified(appCode, modCode, featCode, act, role) {
                    const key = this.getCellKey(appCode, modCode, featCode, act, role);
                    return this.permissionOverrides[key] !== undefined;
                },
                isPermissionNewlyGranted(appCode, modCode, featCode, act, role) {
                    const key = this.getCellKey(appCode, modCode, featCode, act, role);
                    const ov = this.permissionOverrides[key];
                    return !!(ov && ov.granted && !ov.initial);
                },
                isPermissionNewlyRevoked(appCode, modCode, featCode, act, role) {
                    const key = this.getCellKey(appCode, modCode, featCode, act, role);
                    const ov = this.permissionOverrides[key];
                    return !!(ov && !ov.granted && ov.initial);
                },
                getCellTooltip(appCode, modCode, featCode, act, role) {
                    const granted = this.hasRolePermission(appCode, modCode, featCode, act, role);
                    const modified = this.isPermissionModified(appCode, modCode, featCode, act, role);
                    if (modified) {
                        return (granted ? 'Baru dicentang (INSERT). ' : 'Baru dicabut (DELETE). ') + 'Klik untuk batalkan perubahan.';
                    }
                    return granted ? ('Izin aktif untuk ' + role + '. Klik untuk mencabut.') : ('Belum ada izin untuk ' + role + '. Klik untuk memberikan izin.');
                },
                togglePermission(appCode, modCode, featCode, act, role) {
                    const key = this.getCellKey(appCode, modCode, featCode, act, role);
                    const current = this.hasRolePermission(appCode, modCode, featCode, act, role);
                    const initial = !!this.initialPermissions[key];
                    const next = !current;

                    if (next === initial) {
                        delete this.permissionOverrides[key];
                    } else {
                        this.permissionOverrides[key] = {
                            appCode,
                            modCode,
                            featCode,
                            actionCode: act.action,
                            roleName: role,
                            granted: next,
                            initial: initial,
                            featureActionId: act.feature_action_id || ''
                        };
                    }
                    this.permissionOverrides = { ...this.permissionOverrides };
                },
                resetAllChanges() {
                    if (confirm('Batalkan semua perubahan perizinan simulasi?')) {
                        this.permissionOverrides = {};
                    }
                },
                openSqlModal() {
                    this.showSqlModal = true;
                },
                closeSqlModal() {
                    this.showSqlModal = false;
                },
                async copySqlToClipboard() {
                    if (!this.generatedSql) return;
                    try {
                        if (navigator.clipboard && window.isSecureContext) {
                            await navigator.clipboard.writeText(this.generatedSql);
                        } else {
                            const ta = document.createElement('textarea');
                            ta.value = this.generatedSql;
                            ta.style.position = 'fixed';
                            ta.style.left = '-9999px';
                            document.body.appendChild(ta);
                            ta.focus();
                            ta.select();
                            document.execCommand('copy');
                            document.body.removeChild(ta);
                        }
                        this.copiedSql = true;
                        setTimeout(() => {
                            this.copiedSql = false;
                        }, 3000);
                    } catch (err) {
                        console.error('Gagal menyalin SQL:', err);
                    }
                },
                async init() {
                    try {
                        const matRes = await fetch('/api/v1/rbac/matrix', { cache: 'no-store' }).then(r => r.json());
                        this.roles = matRes.roles || [];
                        this.applications = matRes.applications || [];

                        // Store initial permission state for fast diffing
                        this.initialPermissions = {};
                        this.permissionOverrides = {};
                        for (const app of this.applications) {
                            for (const mod of (app.modules || [])) {
                                for (const feat of (mod.features || [])) {
                                    for (const act of (feat.actions || [])) {
                                        for (const role of this.roles) {
                                            const key = this.getCellKey(app.code, mod.code, feat.code, act, role);
                                            this.initialPermissions[key] = !!(act.roles && act.roles[role]);
                                        }
                                    }
                                }
                            }
                        }

                        // Read ?role=... from URL query if present
                        const urlParams = new URLSearchParams(window.location.search);
                        const roleParam = urlParams.get('role');
                        if (roleParam && this.roles.includes(roleParam)) {
                            this.filterRole = roleParam;
                        }
                        // Default all module accordions collapsed
                        this.expandedModules = {};
                        this.loading = false;
                    } catch (err) {
                        console.error("Init error:", err);
                        this.loading = false;
                    }
                }
            },
            mounted() {
                this.init();
            }
        }).mount('#app');
    </script>
</body>
</html>
{{ end }}