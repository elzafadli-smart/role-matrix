{{ define "endpoints.tmpl" }}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartLink GroApp - API Endpoints Matrix</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <!-- jQuery & Select2 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        [v-cloak] { display: none; }
        thead th {
            position: sticky;
            top: 0;
            z-index: 20;
            background-color: #0f172a;
            color: #f8fafc;
        }

        /* Modern Select2 Styling */
        .select2-container .select2-selection--single {
            height: 36px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.5rem !important;
            padding: 3px 8px !important;
            display: flex !important;
            align-items: center !important;
            background-color: #ffffff !important;
            box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05) !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #1e293b !important;
            font-size: 0.8125rem !important;
            line-height: 1.25rem !important;
            padding-left: 2px !important;
            padding-right: 20px !important;
            font-weight: 500 !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 34px !important;
            right: 6px !important;
        }
        .select2-container--default.select2-container--focus .select2-selection--single,
        .select2-container--default.select2-container--open .select2-selection--single {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
            outline: none !important;
        }
        .select2-dropdown {
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.75rem !important;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1) !important;
            overflow: hidden !important;
            font-size: 0.8125rem !important;
            z-index: 99999 !important;
            background-color: #ffffff !important;
        }
        .select2-search--dropdown {
            padding: 8px !important;
            background-color: #f8fafc !important;
            border-bottom: 1px solid #e2e8f0 !important;
        }
        .select2-search--dropdown .select2-search__field {
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.5rem !important;
            padding: 6px 10px !important;
            outline: none !important;
            font-size: 0.8125rem !important;
            width: 100% !important;
            background-color: #ffffff !important;
        }
        .select2-search--dropdown .select2-search__field:focus {
            border-color: #6366f1 !important;
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2) !important;
        }
        .select2-results__option {
            padding: 8px 12px !important;
            font-size: 0.8125rem !important;
            color: #334155 !important;
        }
        .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
            background-color: #4f46e5 !important;
            color: #ffffff !important;
        }
        .select2-container--default .select2-results__option--selected {
            background-color: #e0e7ff !important;
            color: #3730a3 !important;
            font-weight: 600 !important;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col font-sans antialiased">
    <div id="app" v-cloak class="flex flex-col min-h-screen">
        <!-- Top Navigation Bar -->
        <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-40 border-b border-slate-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-white shadow">
                        <i class="fa-solid fa-route text-base"></i>
                    </div>
                    <div>
                        <div class="font-extrabold text-base tracking-tight flex items-center space-x-2">
                            <span>SmartLink</span>
                            <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-400 font-semibold border border-indigo-500/30">API Endpoints Matrix</span>
                        </div>
                        <div class="text-[11px] text-slate-400">Pemetaan Route Endpoint &rarr; Feature Action &rarr; Authorized Roles</div>
                    </div>
                </div>

                <nav class="flex bg-slate-800 p-1 rounded-lg text-xs font-medium space-x-1">
                    <a href="/" class="px-3 py-1.5 rounded-md transition text-slate-300 hover:text-white">
                        <i class="fa-solid fa-id-card-clip mr-1.5"></i> User Inspector
                    </a>
                    <a href="/matrix" class="px-3 py-1.5 rounded-md transition text-slate-300 hover:text-white">
                        <i class="fa-solid fa-table-cells mr-1.5"></i> Matrix Grid
                    </a>
                    <a href="/endpoints" class="px-3 py-1.5 rounded-md transition bg-indigo-600 text-white shadow">
                        <i class="fa-solid fa-route mr-1.5"></i> Endpoints
                    </a>
                    <a href="/ui-routes" class="px-3 py-1.5 rounded-md transition text-slate-300 hover:text-white">
                        <i class="fa-solid fa-compass mr-1.5"></i> UI Routes
                    </a>
                </nav>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="space-y-4">
                <!-- Toolbar: Search, Filters, View Switcher & Accordion Controls -->
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center space-x-3 flex-1 min-w-[260px]">
                        <div class="relative w-full">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
                            <input v-model="searchEndpoint" type="text" placeholder="Cari path, method, module, action, deskripsi..." 
                                class="w-full pl-9 pr-4 py-1.5 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <!-- HTTP Method Filter -->
                        <div class="min-w-[150px]">
                            <select v-model="endpointMethod" v-select2 class="w-full">
                                <option value="">Semua Method</option>
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                                <option value="PATCH">PATCH</option>
                            </select>
                        </div>

                        <!-- Module Filter -->
                        <div class="min-w-[210px] max-w-[260px]">
                            <select v-model="endpointModule" v-select2 class="w-full">
                                <option value="">Semua Module (Accordion)</option>
                                <option v-for="m in availableEndpointModules" :key="m" :value="m">{[ m ]}</option>
                            </select>
                        </div>

                        <!-- Role Filter -->
                        <div class="min-w-[170px]">
                            <select v-model="endpointFilterRole" v-select2 class="w-full">
                                <option value="">Semua Role</option>
                                <option v-for="r in roles" :key="r" :value="r">{[ r ]}</option>
                            </select>
                        </div>

                        <!-- View Mode Switcher -->
                        <div class="flex items-center border border-slate-300 rounded-lg overflow-hidden bg-slate-50">
                            <button @click="endpointViewMode = 'matrix'" type="button" 
                                class="px-2.5 py-1.5 text-xs font-semibold transition flex items-center space-x-1"
                                :class="endpointViewMode === 'matrix' ? 'bg-indigo-600 text-white' : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-100'">
                                <i class="fa-solid fa-table-cells text-[11px]"></i>
                                <span>Matriks</span>
                            </button>
                            <button @click="endpointViewMode = 'list'" type="button" 
                                class="px-2.5 py-1.5 text-xs font-semibold transition flex items-center space-x-1"
                                :class="endpointViewMode === 'list' ? 'bg-indigo-600 text-white' : 'text-slate-700 hover:text-indigo-600 hover:bg-slate-100'">
                                <i class="fa-solid fa-list-ul text-[11px]"></i>
                                <span>Daftar</span>
                            </button>
                        </div>

                        <!-- Accordion Action Buttons -->
                        <div v-if="endpointViewMode === 'matrix'" class="flex items-center border border-slate-300 rounded-lg overflow-hidden bg-slate-50">
                            <button @click="expandAllEndpointModules" type="button" title="Buka Semua Module" class="px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:text-indigo-600 hover:bg-slate-100 transition border-r border-slate-300 flex items-center space-x-1">
                                <i class="fa-solid fa-angles-down text-[11px]"></i>
                                <span>Buka Semua</span>
                            </button>
                            <button @click="collapseAllEndpointModules" type="button" title="Tutup Semua Module" class="px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:text-indigo-600 hover:bg-slate-100 transition flex items-center space-x-1">
                                <i class="fa-solid fa-angles-up text-[11px]"></i>
                                <span>Tutup Semua</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Info Bar -->
                <div class="flex justify-between items-center text-xs text-slate-500 px-1">
                    <span>Menampilkan <strong>{[ filteredEndpoints.length ]}</strong> dari <strong>{[ endpoints.length ]}</strong> endpoint terdaftar</span>
                    <span v-if="endpointFilterRole" class="font-semibold text-indigo-700">Filter Aktif Role: {[ endpointFilterRole ]}</span>
                </div>

                <div v-if="loading" class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center text-slate-500">
                    <i class="fa-solid fa-circle-notch fa-spin text-2xl text-indigo-600 mb-2"></i>
                    <p class="text-xs">Memuat daftar API endpoints...</p>
                </div>

                <!-- VIEW 1: MATRIX GRID VIEW -->
                <div v-else-if="endpointViewMode === 'matrix'" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="overflow-auto max-h-[calc(100vh-210px)]">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead class="sticky top-0 z-20 bg-slate-900 shadow-md border-b-2 border-indigo-500">
                                <tr class="bg-slate-900 text-slate-200 text-xs uppercase tracking-wider font-bold">
                                    <th class="sticky top-0 z-20 bg-slate-900 py-3.5 px-4 font-semibold min-w-[340px] text-white shadow-xs">Endpoint &amp; Permission Mapping</th>
                                    <th class="sticky top-0 z-20 bg-slate-900 py-3.5 px-3 font-semibold min-w-[200px] text-white shadow-xs">Deskripsi &amp; Service</th>
                                    <th v-for="role in roles" :key="role" class="sticky top-0 z-20 bg-slate-900 py-3.5 px-3 text-center font-semibold text-xs shadow-xs transition"
                                        :class="endpointFilterRole === role ? 'bg-indigo-950 text-amber-300 border-x-2 border-indigo-500 font-extrabold shadow-inner' : 'text-slate-200'">
                                        {[ role ]}
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <template v-for="grp in groupedEndpoints" :key="grp.module">
                                    <!-- Module Accordion Header Row -->
                                    <tr @click="toggleEndpointModule(grp.module)" 
                                        class="cursor-pointer select-none transition border-t border-slate-200"
                                        :class="isEndpointModuleOpen(grp.module) ? 'bg-indigo-50/70 hover:bg-indigo-100/70 text-indigo-950' : 'bg-slate-50 hover:bg-slate-100/80 text-slate-700'">
                                        <td :colspan="2 + roles.length" class="py-2.5 px-4 text-xs">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center space-x-2.5">
                                                    <span class="w-4 text-center text-indigo-600 transition-transform">
                                                        <i class="fa-solid" 
                                                           :class="isEndpointModuleOpen(grp.module) ? 'fa-chevron-down' : 'fa-chevron-right'"></i>
                                                    </span>
                                                    <i class="fa-solid text-slate-400" 
                                                       :class="isEndpointModuleOpen(grp.module) ? 'fa-folder-open text-indigo-600' : 'fa-folder'"></i>
                                                    <span class="font-medium">Module: <strong class="font-bold text-slate-900 font-mono">{[ grp.module ]}</strong></span>
                                                    <span class="text-slate-400 text-[11px] font-sans">({[ grp.service ]})</span>
                                                </div>
                                                <div class="flex items-center space-x-2 text-[11px]">
                                                    <span class="px-2 py-0.5 rounded-full font-semibold border"
                                                          :class="isEndpointModuleOpen(grp.module) ? 'bg-indigo-100 border-indigo-200 text-indigo-900' : 'bg-slate-200/70 border-slate-300 text-slate-600'">
                                                        {[ grp.endpoints.length ]} Endpoints
                                                    </span>
                                                    <span class="text-slate-400">
                                                        {[ isEndpointModuleOpen(grp.module) ? '(klik untuk ciutkan)' : '(klik untuk buka)' ]}
                                                    </span>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- Endpoint Rows with Matrix Role Checkmarks -->
                                    <template v-if="isEndpointModuleOpen(grp.module)">
                                        <tr v-for="(ep, idx) in grp.endpoints" :key="idx" class="hover:bg-slate-50/80 transition border-b border-slate-100">
                                            <!-- Method, Path, & Permission -->
                                            <td class="py-2.5 px-4 text-xs">
                                                <div class="flex items-start space-x-2.5 pl-6">
                                                    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold tracking-tight uppercase shrink-0" :class="{
                                                        'bg-blue-100 text-blue-700 border border-blue-200': ep.method === 'GET',
                                                        'bg-emerald-100 text-emerald-700 border border-emerald-200': ep.method === 'POST',
                                                        'bg-amber-100 text-amber-700 border border-amber-200': ep.method === 'PUT',
                                                        'bg-rose-100 text-rose-700 border border-rose-200': ep.method === 'DELETE',
                                                        'bg-purple-100 text-purple-700 border border-purple-200': ep.method === 'PATCH'
                                                    }">
                                                        {[ ep.method ]}
                                                    </span>
                                                    <div>
                                                        <div class="font-mono font-bold text-slate-900 break-all">{[ ep.path ]}</div>
                                                        <div v-if="ep.feature && ep.action" class="text-[11px] text-slate-500 font-mono mt-0.5 flex items-center space-x-1">
                                                            <i class="fa-solid fa-key text-[10px] text-slate-400"></i>
                                                            <span><strong class="text-indigo-600">{[ ep.module ]}</strong>:{[ ep.feature ]}:<strong class="text-amber-600">{[ ep.action ]}</strong></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- Description & Service -->
                                            <td class="py-2.5 px-3 text-xs text-slate-600">
                                                <div class="font-medium text-slate-800">{[ ep.description || '-' ]}</div>
                                                <div class="text-[10px] text-slate-400 mt-0.5">{[ ep.service_name ]}</div>
                                            </td>

                                            <!-- Matrix Role Checkmarks -->
                                            <td v-for="role in roles" :key="role" class="py-2.5 px-3 text-center"
                                                :class="endpointFilterRole === role ? 'bg-indigo-50/50 border-x border-indigo-100' : ''">
                                                <span v-if="ep.authorized_roles && ep.authorized_roles.includes(role)" 
                                                      class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 text-xs shadow-xs"
                                                      :title="role + ' diizinkan'">
                                                    <i class="fa-solid fa-check"></i>
                                                </span>
                                                <span v-else class="inline-block w-2.5 h-0.5 bg-slate-200 rounded" title="Tidak diizinkan"></span>
                                            </td>
                                        </tr>
                                    </template>
                                </template>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- VIEW 2: CLASSIC LIST VIEW -->
                <div v-else class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead class="bg-slate-900 text-slate-200 text-xs uppercase tracking-wider border-b-2 border-indigo-500 font-bold">
                                <tr>
                                    <th class="py-3.5 px-4 font-semibold w-24 text-white">Method</th>
                                    <th class="py-3.5 px-4 font-semibold text-white">Route Path</th>
                                    <th class="py-3.5 px-4 font-semibold text-white">Service &amp; Module</th>
                                    <th class="py-3.5 px-4 font-semibold text-white">Authorized Roles</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 font-mono text-xs">
                                <tr v-for="(ep, i) in filteredEndpoints" :key="i" class="hover:bg-slate-50">
                                    <td class="py-2.5 px-4 font-bold" :class="{
                                        'text-blue-600': ep.method === 'GET',
                                        'text-emerald-600': ep.method === 'POST',
                                        'text-amber-600': ep.method === 'PUT',
                                        'text-rose-600': ep.method === 'DELETE',
                                        'text-purple-600': ep.method === 'PATCH'
                                    }">{[ ep.method ]}</td>
                                    <td class="py-2.5 px-4 text-slate-900 font-medium">{[ ep.path ]}</td>
                                    <td class="py-2.5 px-4 text-slate-600 font-sans">
                                        <div class="font-bold text-slate-800">{[ ep.module ]}</div>
                                        <div class="text-[10px] text-slate-400">{[ ep.service_name ]}</div>
                                    </td>
                                    <td class="py-2.5 px-4 font-sans">
                                        <div class="flex flex-wrap gap-1">
                                            <span v-for="r in ep.authorized_roles" :key="r" class="px-2 py-0.5 rounded-full text-[10px] bg-slate-100 text-slate-700 border border-slate-200 font-medium">
                                                {[ r ]}
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500">
            Powered by <strong>Goravel</strong> framework &bull; SmartLink GroApp RBAC Role Viewer
        </footer>
    </div>

    <script>
        const { createApp } = Vue;

        const select2Directive = {
            mounted(el, binding) {
                const $el = $(el);
                $el.select2({
                    width: '100%',
                    dropdownAutoWidth: true,
                    minimumResultsForSearch: (binding.modifiers && binding.modifiers.nosearch) ? -1 : 0
                });

                el._prevOptionCount = el.options.length;

                $el.on('select2:select select2:unselect select2:clear', function() {
                    el.dispatchEvent(new Event('change', { bubbles: true }));
                });
            },
            updated(el, binding) {
                const $el = $(el);
                const currentOptionCount = el.options.length;
                if (el._prevOptionCount !== currentOptionCount) {
                    el._prevOptionCount = currentOptionCount;
                    $el.select2({
                        width: '100%',
                        dropdownAutoWidth: true,
                        minimumResultsForSearch: (binding.modifiers && binding.modifiers.nosearch) ? -1 : 0
                    });
                }
                if ($el.val() !== el.value) {
                    $el.val(el.value).trigger('change.select2');
                }
            },
            unmounted(el) {
                $(el).select2('destroy');
            }
        };

        createApp({
            delimiters: ['{[', ']}'],
            directives: {
                select2: select2Directive
            },
            data() {
                return {
                    loading: true,
                    roles: [],
                    endpoints: [],
                    searchEndpoint: '',
                    endpointMethod: '',
                    endpointModule: '',
                    endpointFilterRole: '',
                    endpointViewMode: 'matrix',
                    expandedEndpointModules: {},
                };
            },
            computed: {
                availableEndpointModules() {
                    const set = new Set();
                    for (const ep of this.endpoints) {
                        if (ep.module) set.add(ep.module);
                    }
                    return Array.from(set).sort();
                },
                filteredEndpoints() {
                    let list = this.endpoints;
                    if (this.endpointMethod) {
                        list = list.filter(e => e.method === this.endpointMethod);
                    }
                    if (this.endpointModule) {
                        list = list.filter(e => e.module === this.endpointModule);
                    }
                    if (this.endpointFilterRole) {
                        list = list.filter(e => e.authorized_roles && e.authorized_roles.includes(this.endpointFilterRole));
                    }
                    if (!this.searchEndpoint) return list;
                    const kw = this.searchEndpoint.toLowerCase();
                    return list.filter(e => 
                        (e.path && e.path.toLowerCase().includes(kw)) ||
                        (e.method && e.method.toLowerCase().includes(kw)) ||
                        (e.service_name && e.service_name.toLowerCase().includes(kw)) ||
                        (e.module && e.module.toLowerCase().includes(kw)) ||
                        (e.feature && e.feature.toLowerCase().includes(kw)) ||
                        (e.action && e.action.toLowerCase().includes(kw)) ||
                        (e.description && e.description.toLowerCase().includes(kw))
                    );
                },
                groupedEndpoints() {
                    const groups = {};
                    for (const ep of this.filteredEndpoints) {
                        const mod = ep.module || 'OTHERS';
                        if (!groups[mod]) {
                            groups[mod] = {
                                module: mod,
                                service: ep.service_name || 'GroApp Service',
                                endpoints: []
                            };
                        }
                        groups[mod].endpoints.push(ep);
                    }
                    return Object.values(groups);
                }
            },
            methods: {
                isEndpointModuleOpen(moduleName) {
                    if (this.searchEndpoint || this.endpointModule) return true;
                    return !!this.expandedEndpointModules[moduleName];
                },
                toggleEndpointModule(moduleName) {
                    this.expandedEndpointModules[moduleName] = !this.expandedEndpointModules[moduleName];
                    this.expandedEndpointModules = { ...this.expandedEndpointModules };
                },
                expandAllEndpointModules() {
                    const next = {};
                    for (const ep of this.endpoints) {
                        if (ep.module) next[ep.module] = true;
                    }
                    this.expandedEndpointModules = next;
                },
                collapseAllEndpointModules() {
                    this.expandedEndpointModules = {};
                },
                async init() {
                    try {
                        const [epRes, matRes] = await Promise.all([
                            fetch('/api/v1/rbac/endpoints').then(r => r.json()),
                            fetch('/api/v1/rbac/matrix').then(r => r.json())
                        ]);
                        this.endpoints = epRes.data || [];
                        this.roles = matRes.roles || [];

                        if (this.endpoints.length > 0) {
                            const firstEpMod = this.endpoints[0].module || 'CASH_AND_BANK';
                            this.expandedEndpointModules = {
                                [firstEpMod]: true
                            };
                        }
                        this.loading = false;
                    } catch (err) {
                        console.error("Init error:", err);
                        this.loading = false;
                    }
                }
            },
            mounted() {
                this.init();
            }
        }).mount('#app');
    </script>
</body>
</html>
{{ end }}